{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/index.ts",
    "src/app.ts",
    "src/config.ts",
    "src/redis.ts",
    "src/services/keyLock.ts",
    "src/mvp/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
